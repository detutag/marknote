# ── 必填 ────────────────────────────────────────────────────────────────
# Neon 連線字串（建議用 pooled 版本，host 含 -pooler）
# Neon 控制台 → Project → Connection Details → "Pooled connection"
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# 登入密碼（單一密碼，自用設計；不含使用者註冊）
APP_PASSWORD="change-me"

# 簽發 session cookie 用的金鑰，至少 32 字元隨機字串
# 產生方式：openssl rand -base64 48
AUTH_SECRET="change-me-too"

# ── 選填 ────────────────────────────────────────────────────────────────
# 顯示在登入頁與側邊欄的應用程式名稱
NEXT_PUBLIC_APP_NAME="MarkNote"

# Session 有效天數（預設 7）
SESSION_MAX_AGE_DAYS=7

# cookie 安全性：auto（預設，production 視為 https）| true | false
# COOKIE_SECURE=auto

# 閱讀模式允許内嵌 iframe 的網域白名單（逗號分隔）
# 預設已包含 YouTube / Vimeo / Bilibili；留空字串可完全停用 iframe 内嵌
# EMBED_ALLOWLIST="www.youtube.com,youtube-nocookie.com,player.vimeo.com,player.bilibili.com"

# ── 檔案庫（Neon Object Storage，S3 相容；留空則停用檔案庫）─────────────
# Neon Console → Storage 取得的端點與金鑰
# S3_ENDPOINT="https://<你的 Neon 儲存端點>"
# S3_ACCESS_KEY_ID="..."
# S3_SECRET_ACCESS_KEY="..."
# S3_REGION="ap-southeast-1"
# STORAGE_BUCKET="marknote-files"
# 單檔上傳上限（MiB，預設 200，最大 5120）
# STORAGE_MAX_UPLOAD_MB=200
# 上傳時自動把網站來源加進 bucket CORS（預設開啟，設 0 關閉）
# STORAGE_AUTO_CORS="1"
# 手動執行 npm run storage:init 時允許的來源（逗號分隔，一般不需要）
# APP_ORIGIN="http://localhost:3000"

# ── MCP（給外部 AI agent 使用；留空則停用 /api/mcp）─────────────────────
# agent 以 Authorization: Bearer <MCP_TOKEN> 呼叫 https://你的網域/api/mcp
# 產生方式：openssl rand -base64 32
# MCP_TOKEN=""
# 只開放讀取工具（搜尋／列出／讀取），設 1 啟用
# MCP_READONLY=0

# ── AI 整理（任何 OpenAI 相容端點；AI_BASE_URL 與 AI_MODEL 都設定才會啟用）──
# 例：OpenAI https://api.openai.com/v1 ・DeepSeek https://api.deepseek.com/v1
#     OpenRouter https://openrouter.ai/api/v1 ・Ollama http://localhost:11434/v1
# AI_BASE_URL="https://api.openai.com/v1"
# AI_API_KEY="sk-..."          # 本機模型（Ollama、LM Studio）可留空
# AI_MODEL="gpt-4o-mini"
# AI_TEMPERATURE=0.3
# AI_MAX_TOKENS=               # 留空交給模型預設
# AI_MAX_INPUT_CHARS=60000     # 單次送出的字元上限
# AI_TIMEOUT_MS=120000

# 開發／測試用：把 Neon HTTP 查詢導向相容端點（例如 dev/shim 的本地代理）
# 正式環境請留空
# NEON_FETCH_ENDPOINT="http://127.0.0.1:5599/sql"
